#!/usr/bin/env node
"use strict";
// Proof stand-in for cursor-agent. Prints the configured create-chat id.
// The launch argv log is create-chat and a prompted resume, which exits 0.
// When FAKE_CURSOR_RELEASE is set, that prompted resume stays up until the
// release file appears, then exits 0. Resume with no prompt is the embedded
// attach: it is recorded separately,
// prints the ordinary finished prompt `→ Add a follow-up`, and exits on
// SIGHUP as cursor-agent does. Working mode also prints `ctrl+c to stop`.
// Waiting mode prints the observed clarifying question. Unrecognized mode
// prints neither the prompt nor a question. Each mode redraws its screen
// on SIGWINCH.
// It does not write a launch record or a workspace.
const fs = require("node:fs");
const path = require("node:path");

const args = process.argv.slice(2);
const log = process.env.FAKE_CURSOR_LOG;
const home = process.env.HOME;
let stored = null;
if (home) {
  try {
    stored = fs.readFileSync(
      path.join(home, ".open-dough", "dashboard", "agent-launches.json"),
      "utf8",
    );
  } catch (error) {
    if (error.code !== "ENOENT") throw error;
  }
}
// Resume with no prompt is attach, not a launch prompt, so it stays out of
// the launch argv log.
const resumeAt = args.indexOf("--resume");
const resumed = resumeAt >= 0 ? args[resumeAt + 1] : undefined;
const attaching = resumed !== undefined && args.length === resumeAt + 2;
if (log && !attaching) {
  fs.appendFileSync(
    log,
    `${JSON.stringify({
      executable: process.argv[1],
      args,
      cwd: process.cwd(),
      stored,
    })}\n`,
  );
}
if (args[0] === "create-chat") {
  const id = process.env.FAKE_CURSOR_SESSION_ID;
  if (!id) {
    process.stderr.write("missing session id\n");
    process.exit(1);
  }
  process.stdout.write(`${id}\n`);
}
if (attaching) {
  const pid = process.pid;
  const dir = process.env.FAKE_CURSOR_ATTACH_DIR;
  const mode = process.env.FAKE_CURSOR_ATTACH_MODE;
  const screens = {
    working: "→ Add a follow-up\r\nctrl+c to stop\r\n",
    waiting: [
      "│ Clarifying Questions",
      "│ 1. Which do you choose?",
      "│   › [ ] Red",
      "│     [ ] Blue",
      "│ ↑/↓ option · ←/→ question · Space select · Enter next/submit · Esc to skip",
    ].join("\r\n") + "\r\n",
    unrecognized: "Cursor Agent\r\n",
  };
  if (dir) fs.mkdirSync(dir, { recursive: true });
  const paint = () => {
    const body = screens[mode] ?? "→ Add a follow-up\r\n";
    process.stdout.write(`\x1b[?2026h\x1b[?25h\x1b[2J\x1b[H${body}\x1b[?2026l`);
  };
  process.on("SIGHUP", () => {
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.signals`), "SIGHUP\n");
    process.exit(0);
  });
  process.on("SIGWINCH", () => {
    if (dir) {
      fs.appendFileSync(
        path.join(dir, `${pid}.sizes`),
        `${JSON.stringify({
          cols: process.stdout.columns,
          rows: process.stdout.rows,
        })}\n`,
      );
    }
    paint();
  });
  process.stdin.on("error", () => {});
  process.stdout.on("error", () => {});
  if (process.stdin.isTTY) process.stdin.setRawMode(true);
  process.stdin.resume();
  process.stdin.on("data", (chunk) => {
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.input`), chunk);
  });
  if (dir) {
    fs.appendFileSync(
      path.join(dir, "attaches.jsonl"),
      `${JSON.stringify({
        pid,
        executable: process.argv[1],
        cwd: process.cwd(),
        args,
        cols: process.stdout.columns,
        rows: process.stdout.rows,
        sessionId: resumed,
      })}\n`,
    );
  }
  paint();
} else if (process.env.FAKE_CURSOR_RELEASE && resumed !== undefined) {
  holdUntilRelease(process.env.FAKE_CURSOR_RELEASE);
} else {
  process.exit(0);
}

// A prompted launch that outlives the launch wait. Stdin is recorded and
// does not end the process. The process exits 0 once `release` exists.
function holdUntilRelease(release) {
  const pid = process.pid;
  const dir = process.env.FAKE_CURSOR_HOLD_DIR;
  if (dir) {
    fs.mkdirSync(dir, { recursive: true });
    fs.appendFileSync(
      path.join(dir, "holds.jsonl"),
      `${JSON.stringify({ pid, args })}\n`,
    );
  }
  const inputPath = dir ? path.join(dir, `${pid}.input`) : undefined;
  process.stdin.on("error", () => {});
  process.stdin.on("data", (chunk) => {
    if (inputPath) fs.appendFileSync(inputPath, chunk);
  });
  process.stdin.resume();
  const timer = setInterval(() => {
    if (fs.existsSync(release)) {
      clearInterval(timer);
      process.exit(0);
    }
  }, 20);
  process.on("SIGTERM", () => {
    clearInterval(timer);
    process.exit(0);
  });
}
