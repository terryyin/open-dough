#!/usr/bin/env node
"use strict";

// Synthetic `claude`, first on PATH for one isolated dashboard server (see
// ../support/fakeClaude.ts); no real sessions. Logs argv/cwd in calls.jsonl.
// Launch prints the real `claude --bg` line with a colored short id and lists
// a busy/working session with cwd and startedAt (epoch milliseconds). Listing
// exposes status only for running processes; exited sessions need --all.
// The support controls end/forget sessions or fail listing via shared files.
//
// Attach is ./fake-claude-attach.cjs. `stop <id>` lists the session stopped,
// without status; `rm <id>` drops the session from the listing, or refuses
// while `removal-fails` exists.
//
// Scenario file: launched (default), refused, untrusted, hang, held (waits
// for release), unlisted (reports an unlisted session), or launched-hang
// (lists its session, then hangs without reporting it).

const crypto = require("crypto");
const fs = require("fs");
const path = require("path");

const dir = process.env.FAKE_CLAUDE_DIR;
if (!dir) {
  process.stderr.write("fake claude: FAKE_CLAUDE_DIR is not set\n");
  process.exitCode = 1;
  return;
}
const args = process.argv.slice(2);
const cwd = process.cwd();
const agentsPath = path.join(dir, "agents.json");

fs.appendFileSync(
  path.join(dir, "calls.jsonl"),
  `${JSON.stringify({ argv: args, cwd })}\n`,
);

function listed() {
  try {
    return JSON.parse(fs.readFileSync(agentsPath, "utf8"));
  } catch {
    return [];
  }
}

// Concurrent background launches must retain each other's sessions. Atomic
// replacement protects readers; this lock protects the read/change/write too.
function updateListed(change) {
  const lock = `${agentsPath}.lock`;
  const deadline = Date.now() + 5000;
  while (true) {
    try {
      fs.mkdirSync(lock);
      break;
    } catch (error) {
      if (error.code !== "EEXIST" || Date.now() >= deadline) throw error;
      Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 5);
    }
  }
  try {
    const sessions = listed();
    const result = change(sessions);
    // Replaced whole, so a listing never reads a half-written file.
    const next = `${agentsPath}.${process.pid}`;
    fs.writeFileSync(next, JSON.stringify(sessions));
    fs.renameSync(next, agentsPath);
    return result;
  } finally {
    fs.rmdirSync(lock);
  }
}

// Changes the listed session with this short id, if there is one; `drop`
// removes it from the listing.
function changeListed(id, change) {
  return updateListed((sessions) => {
    const index = sessions.findIndex((each) => each.id === id);
    if (index === -1) return false;
    change(sessions[index], () => sessions.splice(index, 1));
    return true;
  });
}

if (args[0] === "rm" && fs.existsSync(path.join(dir, "removal-fails"))) {
  process.stderr.write(
    `Error: fake claude refused to remove ${args[1]} (secret-marker-from-claude-rm)\n`,
  );
  process.exitCode = 1;
  return;
}

if (args[0] === "stop" || args[0] === "rm") {
  const found = changeListed(args[1], (session, drop) => {
    if (args[0] === "rm") return drop();
    delete session.status;
    session.state = "stopped";
  });
  if (!found) {
    process.stderr.write(`Error: no session ${args[1]}\n`);
    process.exitCode = 1;
  }
  return;
}

if (args[0] === "agents") {
  if (fs.existsSync(path.join(dir, "listing-fails"))) {
    process.stderr.write("Error: fake claude could not list its sessions\n");
    process.exitCode = 1;
    return;
  }
  const all = args.includes("--all");
  const sessions = listed().filter(
    (session) => all || session.status !== undefined,
  );
  process.stdout.write(`${JSON.stringify(sessions)}\n`);
  return;
}

if (args[0] === "attach") {
  // Installed beside this script (../support/fakeClaude.ts).
  const attach = require(path.join(__dirname, "attach.cjs"));
  attach(dir, args[1], (name) =>
    changeListed(args[1], (session) => {
      session.name = name;
    }),
  );
  return;
}

let scenario = "launched";
try {
  scenario = fs.readFileSync(path.join(dir, "scenario"), "utf8").trim();
} catch {
  // No scenario file: the default.
}

if (scenario === "held") {
  while (!fs.existsSync(path.join(dir, "release"))) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100);
  }
  scenario = "launched";
}

const nameAt = args.indexOf("--name");
const name = nameAt === -1 ? "" : args[nameAt + 1];

// Lists the launched session busy/working and answers its short id.
function listLaunched() {
  const sessionId = crypto.randomUUID();
  const id = sessionId.slice(0, 8);
  updateListed((sessions) => {
    sessions.push({
      pid: process.pid,
      id,
      cwd,
      kind: "bg",
      startedAt: Date.now(),
      sessionId,
      name,
      status: "busy",
      state: "working",
    });
  });
  return id;
}

switch (scenario) {
  case "refused":
    process.stderr.write(
      `Error: fake claude refused in ${cwd} (secret-marker-from-claude-stderr)\n`,
    );
    process.exitCode = 1;
    return;
  case "untrusted":
    process.stderr.write(
      `Workspace not trusted. Run \`claude\` in ${cwd} once and accept the trust prompt, then retry.\n`,
    );
    process.exitCode = 1;
    return;
  case "launched-hang":
  case "hang":
    if (scenario === "launched-hang") listLaunched();
    fs.writeFileSync(path.join(dir, "pid"), String(process.pid));
    for (const signal of ["SIGTERM", "SIGINT"]) {
      process.on(signal, () => {
        fs.writeFileSync(path.join(dir, "pid.exited"), signal);
        process.exit(143);
      });
    }
    setInterval(() => {}, 1000);
    return;
  default: {
    const id =
      scenario === "unlisted"
        ? crypto.randomUUID().slice(0, 8)
        : listLaunched();
    process.stdout.write(
      `backgrounded · \u001b[36m${id}\u001b[39m · ${name} · trusted\n` +
        `  claude attach ${id}   open the session\n` +
        `  claude logs ${id}     show its output\n`,
    );
  }
}
