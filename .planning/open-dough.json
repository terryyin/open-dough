      {
        "path": "dashboard/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "makeMe": true,
        "pageObjects": true
      },
      {
        "path": "dashboard/frontend-tests",
        "label": "Dashboard Frontend Test",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "makeMe": true,
        "pageObjects": true
      },
      {
        "path": "dashboard/backend-tests",
        "label": "Dashboard Backend Test",
