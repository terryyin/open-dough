+    addEventListener: () => undefined,
+  }),
+};
+
+// Every global fetch and WebSocket the page asks for, outside its typed
+// replies.
+function recordOutsideCalls() {
+  const calls: string[] = [];
+  const fetchAsked = globalThis.fetch.bind(globalThis);
+  vi.spyOn(globalThis, "fetch").mockImplementation((input, init) => {
+    calls.push(
+      `fetch ${input instanceof Request ? input.url : input.toString()}`,
+    );
+    return fetchAsked(input, init);
+  });
+  const Socket = globalThis.WebSocket;
+  vi.stubGlobal(
+    "WebSocket",
+    class extends Socket {
+      constructor(url: string | URL, protocols?: string | string[]) {
+        calls.push(`WebSocket ${String(url)}`);
+        super(url, protocols);
+      }
+    },
+  );
+  return calls;
+}
+
+afterEach(() => {
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
