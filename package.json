{
  "name": "open-dough",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "exec bash scripts/test.sh",
    "lint": "node scripts/lint.mjs",
    "format": "node scripts/lint.mjs --fix",
    "prepare": "node scripts/install-hooks.mjs",
    "dev:dashboard": "vite --config dashboard/vite.config.mts",
    "watch:dashboard": "node scripts/watch-dashboard.mjs",
    "typecheck:dashboard": "tsc --build dashboard/tsconfig.json",
    "build:dashboard": "vite build --config dashboard/vite.config.mts",
    "preview:dashboard": "vite preview --config dashboard/vite.config.mts",
    "setup-notifier:dashboard": "node dashboard/server/notifierSetup.ts",
    "test:dashboard": "playwright test --config dashboard/playwright.config.ts",
    "test:dashboard:frontend": "playwright test --config dashboard/frontend.playwright.config.ts",
    "test:dashboard:backend": "playwright test --config dashboard/backend.playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "lucide-react": "1.72.0",
    "minimatch": "11.0.8",
    "prettier": "3.10.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rolldown": "1.2.19",
    "shiki": "4.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "ws": "8.22.2",
    "zod": "4.6.7"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
