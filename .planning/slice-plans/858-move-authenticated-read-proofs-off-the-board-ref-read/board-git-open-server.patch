diff --git a/dashboard/server/performedRefRead.ts b/dashboard/server/performedRefRead.ts
new file mode 100644
index 000000000..3c343e899
--- /dev/null
+++ b/dashboard/server/performedRefRead.ts
@@ -0,0 +1,47 @@
+// The Board's cold open (`./performedRead.ts`). One shared verified-trunk
+// check answers the backlog it read. Git failure is not asked of REST.
+
+import type { PublishedSource } from "../src/publishedSource.ts";
+import { GhFailure } from "./ghFailure.ts";
+import { observeProjectRevision } from "./observedSessionLandings.ts";
+import type { PinnedTexts } from "./pinnedTexts.ts";
+import { answered, type Outcome } from "./readOutcome.ts";
+import type { SharedVerifiedOriginTrunk } from "./sharedVerifiedOriginTrunk.ts";
+import type { VerifiedOriginTrunk } from "./verifiedOriginTrunk.ts";
+
+export async function performVerifiedTrunkRead(
+  trunks: SharedVerifiedOriginTrunk,
+  pinned: PinnedTexts,
+  source: PublishedSource,
+  signal: AbortSignal,
+): Promise<Outcome> {
+  const demanded = await trunks.demand(source, pinned, signal);
+  if (demanded.kind === "departed") {
+    signal.throwIfAborted();
+    throw signal.reason;
+  }
+  if (demanded.kind === "unanswered") {
+    throw new GhFailure({ kind: "timed-out" });
+  }
+  return admit(trunks, pinned, source, demanded.value);
+}
+
+function admit(
+  trunks: SharedVerifiedOriginTrunk,
+  pinned: PinnedTexts,
+  source: PublishedSource,
+  value: VerifiedOriginTrunk,
+): Outcome {
+  if (value.kind === "verified") {
+    const { revision, backlog } = value;
+    pinned.remember(source, revision, source.backlogPath, backlog);
+    observeProjectRevision(pinned, source, revision);
+    // This backlog is the revision a later trunk is compared with.
+    pinned.answeredBacklog(source, revision);
+    return answered({ revision, backlog, askedAt: trunks.askedAt(source) });
+  }
+  if (value.kind === "missing-trunk") {
+    throw new GhFailure({ kind: "no-commit" });
+  }
+  throw new GhFailure({ kind: "failed" });
+}
