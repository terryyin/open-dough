      {
        "path": "dashboard/frontend-tests",
        "label": "Dashboard Frontend Test",
        "kind": "typescript",
        "include": [
          "**/*.spec.ts"
        ],
        "makeMe": true,
        "pageObjects": true
      },
      {
        "path": "dashboard/backend-tests",
        "label": "Dashboard Backend Test",
        "kind": "typescript",
        "include": [
          "**/*.spec.ts"
        ],
        "makeMe": true
      },
      {
        "path": "Distribution",
        "label": "Distribution Tests",
        "sources": [
          {
            "include": [
              "tests/!(support)/*.sh",
