{
  "skipProcessRetrospective": false,
  "nerds": true,
  "integratedStateCompletion": {
    "check": "ci.yml",
    "context": "push"
  },
  "intent": {
    "locations": [
      {
        "path": "dashboard/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"],
        "runner": "playwright",
        "proof": "dashboard/tests/proof",
        "proofGeneration": {
          "command": "RECORD_PLAYWRIGHT_PROOF=1 npm run --silent test:dashboard -- <files>"
        }
      },
      {
        "path": "tests",
        "kind": "shell",
        "include": ["*.sh"]
      },
      {
        "path": "src/skills",
        "kind": "javascript",
        "include": ["**/*.test.mjs"]
      }
    ]
  }
}
