#!/usr/bin/env node
"use strict";

// A synthetic `claude` this suite puts first on PATH for one isolated
// dashboard server (see ../support/fakeClaude). It never starts a real
// session: it appends its argv and working directory to a calls file, answers
// the way the test's scenario file says, and lists the sessions it
// "launched" through `claude agents --json` the way the real one does: a
// session's `status` (busy or idle) is present only while its process runs,
// and one whose process has exited is listed only with `--all`. A launch
// prints the line the real `claude --bg` prints, its id colored for a
// terminal, and lists its session busy and working. The test's controls
// (../support/fakeClaude.ts) end or forget a listed session, or make the
// listing fail, by editing the same state files.
//
// `claude attach <id>`, run in a terminal, stands in for Claude Code's
// interactive session: it prints `attached <id> <cols>x<rows>`, echoes what
// is typed and each line entered as `echo <line>`, clears the line on Ctrl+U,
// prints `resized <cols>x<rows>` when its terminal's size changes, and
// detaches on Ctrl+Z, exiting on its own as the real one does. A line
// `/rename <name>` renames its listed session instead, printing `Session
// renamed to: <name>`. It records its pid in `attaches.jsonl`, each line
// entered in `attach.<pid>.lines`, and, once a signal or Ctrl+Z ends it, that
// signal or `Ctrl+Z` in `attach.<pid>.ended`, for the controls to observe.
// With a `renames-ignored` file it prints the same but leaves the listing's
// name unchanged. `claude stop <id>` lists that session stopped, with no `status`.
//
// Scenarios: `launched` (default), `refused`, `untrusted`, `hang`, `held`
// (launches once a `release` file exists), and `unlisted` (reports a session
// that `agents --json` does not list).

const crypto = require("crypto");
const fs = require("fs");
const path = require("path");

const dir = process.env.FAKE_CLAUDE_DIR;
if (!dir) {
  process.stderr.write("fake claude: FAKE_CLAUDE_DIR is not set\n");
  process.exitCode = 1;
  return;
}
const args = process.argv.slice(2);
const cwd = process.cwd();
const agentsPath = path.join(dir, "agents.json");

fs.appendFileSync(
  path.join(dir, "calls.jsonl"),
  `${JSON.stringify({ argv: args, cwd })}\n`,
);

function listed() {
  try {
    return JSON.parse(fs.readFileSync(agentsPath, "utf8"));
  } catch {
    return [];
  }
}

// Replaced whole, so a listing never reads a half-written file.
function list(sessions) {
  const next = `${agentsPath}.${process.pid}`;
  fs.writeFileSync(next, JSON.stringify(sessions));
  fs.renameSync(next, agentsPath);
}

// Changes the listed session with this short id, if there is one.
function changeListed(id, change) {
  const sessions = listed();
  const session = sessions.find((each) => each.id === id);
  if (session === undefined) {
    return false;
  }
  change(session);
  list(sessions);
  return true;
}

if (args[0] === "stop") {
  const stopped = changeListed(args[1], (session) => {
    delete session.status;
    session.state = "stopped";
  });
  if (!stopped) {
    process.stderr.write(`Error: no session ${args[1]}\n`);
    process.exitCode = 1;
  }
  return;
}

if (args[0] === "agents") {
  if (fs.existsSync(path.join(dir, "listing-fails"))) {
    process.stderr.write("Error: fake claude could not list its sessions\n");
    process.exitCode = 1;
    return;
  }
  const all = args.includes("--all");
  const sessions = listed().filter(
    (session) => all || session.status !== undefined,
  );
  process.stdout.write(`${JSON.stringify(sessions)}\n`);
  return;
}

if (args[0] === "attach") {
  const id = args[1];
  const size = () => `${process.stdout.columns}x${process.stdout.rows}`;
  fs.appendFileSync(
    path.join(dir, "attaches.jsonl"),
    `${JSON.stringify({ pid: process.pid, id })}\n`,
  );
  for (const signal of ["SIGHUP", "SIGTERM", "SIGINT"]) {
    process.on(signal, () => {
      fs.writeFileSync(path.join(dir, `attach.${process.pid}.ended`), signal);
      process.exit(128);
    });
  }
  process.stdout.write(`attached ${id} ${size()}\r\n`);
  process.stdout.on("resize", () => {
    process.stdout.write(`\r\nresized ${size()}\r\n`);
  });
  let line = "";
  // The terminal may go before the signal that ends this process arrives.
  process.stdin.on("error", () => {});
  process.stdout.on("error", () => {});
  process.stdin.setRawMode(true);
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (typed) => {
    for (const key of typed) {
      if (key === "\r" || key === "\n") {
        fs.appendFileSync(
          path.join(dir, `attach.${process.pid}.lines`),
          `${JSON.stringify(line)}\n`,
        );
        const renamed = /^\/rename (.+)$/.exec(line)?.[1];
        if (renamed === undefined) {
          process.stdout.write(`\r\necho ${line}\r\n`);
        } else {
          // A `renames-ignored` file leaves the listed name as it was.
          if (!fs.existsSync(path.join(dir, "renames-ignored"))) {
            changeListed(id, (session) => {
              session.name = renamed;
            });
          }
          process.stdout.write(`\r\nSession renamed to: ${renamed}\r\n`);
        }
        line = "";
      } else if (key === "\u001a") {
        fs.writeFileSync(
          path.join(dir, `attach.${process.pid}.ended`),
          "Ctrl+Z",
        );
        process.stdout.write("\r\ndetached\r\n", () => {
          process.exit(0);
        });
        return;
      } else if (key === "\u0015") {
        line = "";
        process.stdout.write("\r\u001b[K");
      } else {
        line += key;
        process.stdout.write(key);
      }
    }
  });
  return;
}

let scenario = "launched";
try {
  scenario = fs.readFileSync(path.join(dir, "scenario"), "utf8").trim();
} catch {
  // No scenario file: the default.
}

if (scenario === "held") {
  while (!fs.existsSync(path.join(dir, "release"))) {
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 100);
  }
  scenario = "launched";
}

const nameAt = args.indexOf("--name");
const name = nameAt === -1 ? "" : args[nameAt + 1];

switch (scenario) {
  case "refused":
    process.stderr.write(
      `Error: fake claude refused in ${cwd} (secret-marker-from-claude-stderr)\n`,
    );
    process.exitCode = 1;
    return;
  case "untrusted":
    process.stderr.write(
      `Workspace not trusted. Run \`claude\` in ${cwd} once and accept the trust prompt, then retry.\n`,
    );
    process.exitCode = 1;
    return;
  case "hang":
    fs.writeFileSync(path.join(dir, "pid"), String(process.pid));
    for (const signal of ["SIGTERM", "SIGINT"]) {
      process.on(signal, () => {
        fs.writeFileSync(path.join(dir, "pid.exited"), signal);
        process.exit(143);
      });
    }
    setInterval(() => {}, 1000);
    return;
  default: {
    const sessionId = crypto.randomUUID();
    const id = sessionId.slice(0, 8);
    if (scenario !== "unlisted") {
      list([
        ...listed(),
        {
          pid: process.pid,
          id,
          cwd,
          kind: "bg",
          startedAt: Date.now(),
          sessionId,
          name,
          status: "busy",
          state: "working",
        },
      ]);
    }
    process.stdout.write(
      `backgrounded · \u001b[36m${id}\u001b[39m · ${name} · trusted\n` +
        `  claude attach ${id}   open the session\n` +
        `  claude logs ${id}     show its output\n`,
    );
  }
}
