# The suite's time budget on CI's runner, judged per split job: no single job
# may take longer than per-job-seconds, and one split job's jobs together no
# more than total-job-seconds. scripts/test.sh compares each CI split job's
# per-job times with it, and a breach fails that split job; a local
# run is not judged against it. Set from CI's split test-times artifacts at
# 1.5x or more of the largest values observed on 2026-10-11: over ten main
# runs (scripts/ci-test-times.sh, 2026-10-10T13:38Z to 2026-10-11T00:41Z) and
# run 38099358635, whose split 2/3 ran on a runner 1.6 times slower than the
# same jobs on main. Largest job 49.3 s
# (git-publication-native-one-shot-results.sh; 1.5x is 73.95, rounded up to
# 74), largest split total 470.2 job-seconds (1.5x is 705.3, rounded up to
# 710). Raising either number is a
# reviewed edit, not a way to make a slow change pass.
# Check a change against recent trunk CI times with
# `bash scripts/ci-test-times.sh` (tests/time-budget.md).
per-job-seconds=74
# 2026-10-28: SEED-163 trunk integrate a32cebc3 and branch tip 2ba5950d saw
# split 1/3 totals 728.7 and 741.0 job-seconds with no assertion failures
# (runner load). Raise total to 750; keep per-job ceiling.
total-job-seconds=750
