{
  "version": 1,
  "unrelatedCursor": "compatibility-acceptance-sentinel",
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "node .agents/skills/dough-execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "node .agents/skills/dough-execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5
      }
    ],
    "stop": [
      {
        "command": "node .agents/skills/dough-execute-plan/scripts/ci-host-hook.mjs cursor",
        "timeout": 5,
        "loop_limit": 5
      }
    ]
  }
}
