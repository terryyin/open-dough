#!/usr/bin/env node
"use strict";

// A synthetic `gh` this suite puts first on PATH for one isolated dashboard
// server (see ../support/dashboardServer). It never touches the network or
// real credentials: it hands its argv to the test's own fake GitHub
// (../support/fakeGitHub, at FAKE_GH_ORIGIN) and prints exactly the stdout,
// stderr, and exit code that fake answers with -- the way the real `gh`
// would print GitHub's answer. That fake records every invocation, argv and
// all, as it arrives -- including invocations that it then holds or fails --
// so refusal-before-launch and pinned-argument assertions have something to
// inspect, and a held answer keeps this process alive to prove cancellation.

const fs = require("fs");
const http = require("http");

const args = process.argv.slice(2);
const origin = process.env.FAKE_GH_ORIGIN;
const pidPath = process.env.FAKE_GH_PIDFILE;

if (pidPath) {
  fs.writeFileSync(pidPath, String(process.pid));
}
for (const signal of ["SIGTERM", "SIGINT"]) {
  process.on(signal, () => {
    if (pidPath) {
      fs.writeFileSync(`${pidPath}.exited`, signal);
    }
    process.exit(143);
  });
}

if (!origin) {
  process.stderr.write("fake gh: FAKE_GH_ORIGIN is not set\n");
  process.exitCode = 1;
  return;
}

const request = http.request(
  origin,
  { method: "POST", headers: { "content-type": "application/json" } },
  (response) => {
    const chunks = [];
    response.on("data", (chunk) => chunks.push(chunk));
    response.on("end", () => {
      const reply = JSON.parse(Buffer.concat(chunks).toString("utf8"));
      process.stdout.write(reply.stdout || "");
      process.stderr.write(reply.stderr || "");
      process.exitCode = reply.exitCode || 0;
    });
  },
);
request.on("error", () => {
  process.stderr.write("fake gh: the test's fake GitHub is gone\n");
  process.exitCode = 1;
});
request.end(JSON.stringify(args));
