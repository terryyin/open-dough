"use strict";

// Terminal client for ./fake-cursor: attach log, fixed screens, paste chip,
// SIGHUP, paint delay, split paint, and optional silent hold after paste Enter.

const fs = require("node:fs");
const path = require("node:path");

module.exports = function attachCursor({ args, resumed, stored, env }) {
  const pid = process.pid;
  const dir = process.env.FAKE_CURSOR_ATTACH_DIR;
  let mode = process.env.FAKE_CURSOR_ATTACH_MODE;
  const modeFile = process.env.FAKE_CURSOR_ATTACH_MODE_FILE;
  if (modeFile) {
    try {
      const next = fs.readFileSync(modeFile, "utf8").trim();
      if (next !== "") mode = next;
    } catch (error) {
      if (error.code !== "ENOENT") throw error;
    }
  }
  require(path.join(__dirname, "fake-cursor-model-persistence.cjs"))(args);
  const unclassifiedExit =
    "Cursor resume failed for an unclassified reason.\r\n";
  const cannotLoadExit = `${
    process.env.FAKE_CURSOR_CANNOT_LOAD ?? "Cursor could not load this chat."
  }\r\n`;
  const screens = {
    working: "→ Add a follow-up\r\nctrl+c to stop\r\n",
    "follow-up": "→ Add a follow-up\r\n",
    // The native interruption/failure shape slice 1 of plan 324 recorded:
    // a cancelled command and a nonzero exit sit in viewport history
    // above an ordinary follow-up prompt. No screen proves either state.
    "cancelled-follow-up": `${[
      "$ sleep 45",
      "Cancelled • 3.7s",
      "$ false",
      "exit 1 • 184ms",
      "The exit code was 1.",
      "→ Add a follow-up",
      "Press Ctrl+C again to exit",
    ].join("\r\n")}\r\n`,
    // The native clarifying-question shape: an agent-chosen title, a
    // `Question N of M` line, numbered question lines, and the selection
    // footer. The words `Clarifying Questions` never appear natively.
    waiting: `${[
      "Color preference",
      "Question 1 of 1",
      "1. Which color do you prefer, Red or Blue?",
      "› [ ] Red",
      "  [ ] Blue",
      "  [ ] Other: (type to answer)",
      "↑/↓ option · ←/→ question · Space select · Enter next/submit · Esc to skip",
    ].join("\r\n")}\r\n`,
    unrecognized: "Cursor Agent\r\n",
    trust: "Do you trust this workspace?\r\n",
    "trust-unframed":
      "\x1b[1;33mWorkspace Trust Required\x1b[0m\r\n" +
      "Do you trust the contents of this directory?\r\n" +
      "\x1b[1;32m[a] Trust this workspace\x1b[0m\r\n" +
      "\x1b[2m[q] Quit\x1b[0m\r\n",
    composer: "→ Plan, search, build anything\r\n",
    exit: unclassifiedExit,
    "cannot-load": cannotLoadExit,
  };
  const recordAttach = () => {
    if (!dir) return;
    fs.mkdirSync(dir, { recursive: true });
    fs.appendFileSync(
      path.join(dir, "attaches.jsonl"),
      `${JSON.stringify({
        pid,
        executable: process.argv[1],
        cwd: process.cwd(),
        args,
        cols: process.stdout.columns,
        rows: process.stdout.rows,
        stdinTTY: process.stdin.isTTY === true,
        stdoutTTY: process.stdout.isTTY === true,
        sessionId: resumed,
        stored,
        env,
      })}\n`,
    );
  };
  if (mode === "exit" || mode === "cannot-load") {
    recordAttach();
    const exitText = process.env.FAKE_CURSOR_EXIT_TEXT;
    process.stdout.write(
      mode === "cannot-load"
        ? cannotLoadExit
        : exitText !== undefined && exitText !== ""
          ? exitText
          : unclassifiedExit,
    );
    // cannot-load is one-shot so a replacement attach paints the idle composer.
    if (mode === "cannot-load" && modeFile) {
      try {
        fs.unlinkSync(modeFile);
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
      }
    }
    process.exit(1);
  }
  const splitMs = Number(process.env.FAKE_CURSOR_SPLIT_PAINT_MS || 0);
  let writes = Promise.resolve();
  // Writes one screen's parts in order, apart only in split mode.
  const emit = (...parts) => {
    if (splitMs <= 0) {
      process.stdout.write(parts.join(""));
      return;
    }
    parts.forEach((part, index) => {
      writes = writes.then(
        () =>
          new Promise((resolve) => {
            setTimeout(
              () => {
                process.stdout.write(part);
                resolve();
              },
              index === 0 ? 0 : splitMs,
            );
          }),
      );
    });
  };
  const paint = () => {
    const body = screens[mode] ?? "→ Add a follow-up\r\n";
    if (mode === "composer" || mode === "trust-unframed") {
      emit(`\x1b[?25l\x1b[2J\x1b[H${body}`);
      return;
    }
    emit(`\x1b[?2026h\x1b[?25h\x1b[2J\x1b[H${body}`, "\x1b[?2026l");
  };
  process.on("SIGHUP", () => {
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.signals`), "SIGHUP\n");
    process.exit(0);
  });
  process.on("SIGWINCH", () => {
    if (dir) {
      fs.appendFileSync(
        path.join(dir, `${pid}.sizes`),
        `${JSON.stringify({
          cols: process.stdout.columns,
          rows: process.stdout.rows,
        })}\n`,
      );
    }
    // Native Cursor's held trust screen produced no output for the
    // dashboard's synchronous column nudge. Hold this substitute paint so
    // a joined socket cannot rely on that nudge to see its existing screen.
    if (mode !== "trust-unframed") paint();
  });
  process.stdin.on("error", () => {});
  process.stdout.on("error", () => {});
  if (process.stdin.isTTY) process.stdin.setRawMode(true);
  process.stdin.resume();
  // A long multiline chunk is an unsent paste chip. A later Enter submits
  // that chip, including when the terminal delivers it joined to the paste's
  // last chunk. A return folded into the first chunk does not. The submitted
  // chip stays on screen for FAKE_CURSOR_SUBMIT_PAINT_MS before the repaint,
  // unless FAKE_CURSOR_HOLD_AFTER_PASTE holds keep open with no answering paint.
  const submitPaintMs = Number(process.env.FAKE_CURSOR_SUBMIT_PAINT_MS || 0);
  let pendingPaste = "";
  process.stdin.on("data", (chunk) => {
    const text = chunk.toString("utf8");
    if (pendingPaste !== "" && !/[\r\n]$/.test(text)) {
      pendingPaste += text;
      return;
    }
    if (pendingPaste !== "") {
      pendingPaste += text.slice(0, -1);
      if (dir) {
        fs.appendFileSync(path.join(dir, `${pid}.input`), `${pendingPaste}\r`);
      }
      pendingPaste = "";
      if (process.env.FAKE_CURSOR_HOLD_AFTER_PASTE === "1") {
        return;
      }
      if (submitPaintMs > 0) setTimeout(paint, submitPaintMs);
      else paint();
      return;
    }
    const stripped = text.endsWith("\r") ? text.slice(0, -1) : text;
    if (stripped.includes("\n") || stripped.length > 800) {
      pendingPaste = stripped;
      const lines = (stripped.match(/\n/g) ?? []).length + 1;
      emit("\x1b[?25l\x1b[2J\x1b[H", `→ [Pasted text #1 +${lines} lines]\r\n`);
      return;
    }
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.input`), chunk);
    if ((mode === "trust" || mode === "trust-unframed") && text === "a") {
      mode = "composer";
      paint();
    }
  });
  recordAttach();
  const delay = Number(process.env.FAKE_CURSOR_PAINT_DELAY_MS || 0);
  if (delay > 0) setTimeout(paint, delay);
  else paint();
  const readyFile = process.env.FAKE_CURSOR_BECOME_READY;
  if (readyFile) {
    const timer = setInterval(() => {
      if (fs.existsSync(readyFile)) {
        clearInterval(timer);
        mode = "";
        paint();
      }
    }, 20);
  }
  // A mode written after this client started repaints it in that mode, so a
  // test can walk one held session through working, waiting, and review.
  if (modeFile) {
    setInterval(() => {
      let next;
      try {
        next = fs.readFileSync(modeFile, "utf8").trim();
      } catch (error) {
        if (error.code !== "ENOENT") throw error;
        return;
      }
      if (next !== "" && next !== mode) {
        mode = next;
        paint();
      }
    }, 20);
  }
};
