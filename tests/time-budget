# The suite's time budget on CI's runner, judged per split job: no single job
# may take longer than per-job-seconds, and one split job's jobs together no
# more than total-job-seconds. scripts/test.sh compares each CI split job's
# per-job times with it, and a breach fails that `test (<i>/2)` job; a local
# run is not judged against it. Set from CI's test-times artifacts at 1.5x or
# more of the largest observed values (largest job 46.3 s,
# git-publication-native.sh, over four CI runs of 146c373). The total is
# provisional until split runs are measured: 1.5x the larger share, 303.7 of
# 569.5 job-seconds, when 199ae44's unsplit test-times is dealt into today's
# two shares. Raising either number is a reviewed edit, not a way to make a
# slow change pass.
per-job-seconds=70
total-job-seconds=460
