{
  "skipProcessRetrospective": false,
  "nerds": true,
  "integratedStateCompletion": {
    "check": "ci.yml",
    "context": "push"
  },
  "intent": {
    "locations": [
      {
        "path": "dashboard/tests",
        "kind": "typescript",
        "include": ["**/*.spec.ts"]
      },
      {
        "path": "dashboard/frontend-tests",
        "label": "Dashboard Frontend Test",
        "kind": "typescript",
        "include": ["**/*.spec.ts"]
      },
      {
        "path": "dashboard/backend-tests",
        "label": "Dashboard Backend Test",
        "kind": "typescript",
        "include": ["**/*.spec.ts"]
      },
      {
        "path": "tests",
        "kind": "shell",
        "include": ["*.sh"]
      },
      {
        "path": "src/skills",
        "kind": "javascript",
        "include": ["**/*.test.mjs"]
      }
    ]
  }
}
