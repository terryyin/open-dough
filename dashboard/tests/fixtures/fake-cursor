#!/usr/bin/env node
"use strict";
// Proof stand-in for cursor-agent. Prints the configured create-chat id.
// The launch argv log is create-chat. A resume with no prompt argument is
// the terminal client, including `--model <id>` and no prompt: it is
// recorded as an attach, prints the ordinary finished prompt
// `→ Add a follow-up`, and exits on SIGHUP as cursor-agent does. Working
// mode also prints `ctrl+c to stop`. Waiting mode prints the observed
// clarifying question. Trust mode prints a non-ready screen. Unrecognized
// mode prints neither the prompt nor a question. Composer mode prints
// `→ Plan, search, build anything` with the cursor hidden and no
// synchronized-update frame. Each mode redraws its
// screen on SIGWINCH. FAKE_CURSOR_BECOME_READY, once that file exists,
// repaints the ordinary prompt. FAKE_CURSOR_PAINT_DELAY_MS waits that long
// before the first paint. FAKE_CURSOR_SPLIT_PAINT_MS delivers each screen in
// two writes that far apart, as a terminal can deliver one screen in separate
// reads: a synchronized frame's end follows its content, and a paste chip's
// text follows its cleared screen. Input is answered after earlier writes.
// It does not write a launch record or a workspace. `models` is logged apart
// from launch argv and prints FAKE_CURSOR_MODELS; without that file it fails.
const fs = require("node:fs");
const path = require("node:path");

const args = process.argv.slice(2);
if (args[0] === "models") {
  const modelsLog = process.env.FAKE_CURSOR_MODELS_LOG;
  if (modelsLog) {
    fs.appendFileSync(
      modelsLog,
      `${JSON.stringify({ args, cwd: process.cwd() })}\n`,
    );
  }
  let listing;
  try {
    listing = fs.readFileSync(process.env.FAKE_CURSOR_MODELS ?? "", "utf8");
  } catch {
    process.stderr.write("Could not list models\n");
    process.exit(1);
  }
  process.stdout.write(listing);
  process.exit(0);
}
const log = process.env.FAKE_CURSOR_LOG;
const home = process.env.HOME;
let stored = null;
if (home) {
  try {
    stored = fs.readFileSync(
      path.join(home, ".open-dough", "dashboard", "agent-launches.json"),
      "utf8",
    );
  } catch (error) {
    if (error.code !== "ENOENT") throw error;
  }
}
// A resume with no prompt argument is the terminal client, including
// `--model <id>`. A prompt argument is not. The client stays out of the
// launch argv log.
const valuedFlags = new Set(["--workspace", "--resume", "--model"]);
const positionals = [];
for (let i = 0; i < args.length; i += 1) {
  if (valuedFlags.has(args[i])) {
    i += 1;
    continue;
  }
  if (args[i].startsWith("-")) continue;
  positionals.push(args[i]);
}
const resumeAt = args.indexOf("--resume");
const resumed = resumeAt >= 0 ? args[resumeAt + 1] : undefined;
const attaching = resumed !== undefined && positionals.length === 0;
if (log && !attaching) {
  fs.appendFileSync(
    log,
    `${JSON.stringify({
      executable: process.argv[1],
      args,
      cwd: process.cwd(),
      stored,
    })}\n`,
  );
}
if (args[0] === "create-chat") {
  const id = process.env.FAKE_CURSOR_SESSION_ID;
  if (!id) {
    process.stderr.write("missing session id\n");
    process.exit(1);
  }
  process.stdout.write(`${id}\n`);
}
if (attaching) {
  const pid = process.pid;
  const dir = process.env.FAKE_CURSOR_ATTACH_DIR;
  let mode = process.env.FAKE_CURSOR_ATTACH_MODE;
  const screens = {
    working: "→ Add a follow-up\r\nctrl+c to stop\r\n",
    waiting:
      [
        "│ Clarifying Questions",
        "│ 1. Which do you choose?",
        "│   › [ ] Red",
        "│     [ ] Blue",
        "│ ↑/↓ option · ←/→ question · Space select · Enter next/submit · Esc to skip",
      ].join("\r\n") + "\r\n",
    unrecognized: "Cursor Agent\r\n",
    trust: "Do you trust this workspace?\r\n",
    composer: "→ Plan, search, build anything\r\n",
  };
  if (dir) fs.mkdirSync(dir, { recursive: true });
  const splitMs = Number(process.env.FAKE_CURSOR_SPLIT_PAINT_MS || 0);
  let writes = Promise.resolve();
  // Writes one screen's parts in order, apart only in split mode.
  const emit = (...parts) => {
    if (splitMs <= 0) {
      process.stdout.write(parts.join(""));
      return;
    }
    parts.forEach((part, index) => {
      writes = writes.then(
        () =>
          new Promise((resolve) => {
            setTimeout(
              () => {
                process.stdout.write(part);
                resolve();
              },
              index === 0 ? 0 : splitMs,
            );
          }),
      );
    });
  };
  const paint = () => {
    const body = screens[mode] ?? "→ Add a follow-up\r\n";
    if (mode === "composer") {
      emit(`\x1b[?25l\x1b[2J\x1b[H${body}`);
      return;
    }
    emit(`\x1b[?2026h\x1b[?25h\x1b[2J\x1b[H${body}`, "\x1b[?2026l");
  };
  process.on("SIGHUP", () => {
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.signals`), "SIGHUP\n");
    process.exit(0);
  });
  process.on("SIGWINCH", () => {
    if (dir) {
      fs.appendFileSync(
        path.join(dir, `${pid}.sizes`),
        `${JSON.stringify({
          cols: process.stdout.columns,
          rows: process.stdout.rows,
        })}\n`,
      );
    }
    paint();
  });
  process.stdin.on("error", () => {});
  process.stdout.on("error", () => {});
  if (process.stdin.isTTY) process.stdin.setRawMode(true);
  process.stdin.resume();
  // A long multiline chunk is an unsent paste chip. A later Enter submits
  // that chip, including when the terminal delivers it joined to the paste's
  // last chunk. A return folded into the first chunk does not.
  let pendingPaste = "";
  process.stdin.on("data", (chunk) => {
    const text = chunk.toString("utf8");
    if (pendingPaste !== "" && !/[\r\n]$/.test(text)) {
      pendingPaste += text;
      return;
    }
    if (pendingPaste !== "") {
      pendingPaste += text.slice(0, -1);
      if (dir) {
        fs.appendFileSync(path.join(dir, `${pid}.input`), `${pendingPaste}\r`);
      }
      pendingPaste = "";
      paint();
      return;
    }
    const stripped = text.endsWith("\r") ? text.slice(0, -1) : text;
    if (stripped.includes("\n") && stripped.length > 800) {
      pendingPaste = stripped;
      const lines = (stripped.match(/\n/g) ?? []).length + 1;
      emit(
        "\x1b[?25l\x1b[2J\x1b[H",
        `→ [Pasted text #1 +${lines} lines]\r\n`,
      );
      return;
    }
    if (dir) fs.appendFileSync(path.join(dir, `${pid}.input`), chunk);
  });
  if (dir) {
    fs.appendFileSync(
      path.join(dir, "attaches.jsonl"),
      `${JSON.stringify({
        pid,
        executable: process.argv[1],
        cwd: process.cwd(),
        args,
        cols: process.stdout.columns,
        rows: process.stdout.rows,
        sessionId: resumed,
        stored,
      })}\n`,
    );
  }
  const delay = Number(process.env.FAKE_CURSOR_PAINT_DELAY_MS || 0);
  if (delay > 0) setTimeout(paint, delay);
  else paint();
  const readyFile = process.env.FAKE_CURSOR_BECOME_READY;
  if (readyFile) {
    const timer = setInterval(() => {
      if (fs.existsSync(readyFile)) {
        clearInterval(timer);
        mode = "";
        paint();
      }
    }, 20);
  }
} else if (resumed !== undefined) {
  process.stderr.write("a prompt argument is not a terminal client\n");
  process.exit(2);
} else {
  process.exit(0);
}
